// Project SC — hardware procurement theme (OEMs & components)
const STATE_KEY = 'project-sc-v1'
const defaultState = {
  cash: 1000,
  inventory: 0,
  demandPerSec: 1,
  pos: [],
  oems: [
    {id: 'OEM-SSD', name: 'Alpha SSD Co', part: 'SSD', unitCost: 50, reliability: 0.95, leadModifier: 1.0},
    {id: 'OEM-DIMM', name: 'Beta Memory', part: 'DIMM', unitCost: 20, reliability: 0.85, leadModifier: 1.1},
    {id: 'OEM-CPU', name: 'Gamma Compute', part: 'CPU', unitCost: 200, reliability: 0.75, leadModifier: 1.3}
  ],
  log: []
}
let state = loadState()
let nextPoId = (state.pos && state.pos.length) ? Math.max(...state.pos.map(p=>p.id))+1 : 1

const el = {
  cash: document.getElementById('cash'),
  inventory: document.getElementById('inventory'),
  demand: document.getElementById('demand'),
  supplierSelect: document.getElementById('supplierSelect'),
  poQty: document.getElementById('poQty'),
  poLead: document.getElementById('poLead'),
  placePo: document.getElementById('placePo'),
  posList: document.getElementById('posList'),
  log: document.getElementById('log'),
  save: document.getElementById('save'),
  reset: document.getElementById('reset')
}

function format(n){ return Math.floor(n).toLocaleString() }
function save(){ localStorage.setItem(STATE_KEY, JSON.stringify(state)) }
function loadState(){ try{ const s = JSON.parse(localStorage.getItem(STATE_KEY)); return s ? s : JSON.parse(JSON.stringify(defaultState)) }catch(e){ return JSON.parse(JSON.stringify(defaultState)) } }
function log(msg){ state.log.push(`${new Date().toLocaleTimeString()} - ${msg}`); render(); save() }

function populateOEMs(){ el.supplierSelect.innerHTML = ''; (state.oems||[]).forEach(o=>{ const opt = document.createElement('option'); opt.value=o.id; opt.textContent=`${o.name} — ${o.part} ($${o.unitCost})`; el.supplierSelect.appendChild(opt) }) }

function render(){ el.cash.textContent = format(state.cash); el.inventory.textContent = format(state.inventory); el.demand.textContent = state.demandPerSec;
  if (state.pos.length===0) { el.posList.textContent='(none)' } else { el.posList.innerHTML=''; state.pos.forEach(p=>{ const o = (state.oems||[]).find(x=>x.id===p.supplierId); const div = document.createElement('div'); const remaining = p.commitEta ? Math.max(0, Math.ceil((p.commitEta - Date.now())/1000)) : (p.arrival ? Math.max(0, Math.ceil((p.arrival - Date.now())/1000)) : '-'); div.innerHTML = `<strong>PO #${p.id}</strong> [${o.name}] part ${o.part} qty ${p.qty} - status: ${p.status}` + (p.commitQty? `, commit: ${p.commitQty}` : '') + (p.commitEta? `, ETA ${remaining}s` : ''); el.posList.appendChild(div) }) }
  el.log.innerHTML = state.log.slice(-100).map(l=>`<div>${l}</div>`).join('') }

function placePO(){ const qty=Math.max(1,parseInt(el.poQty.value)||1); const lead=parseInt(el.poLead.value)||15; const supplierId=el.supplierSelect.value; const o = (state.oems||[]).find(x=>x.id===supplierId); const cost = qty * (o.unitCost||10); if(state.cash < cost){ alert('Not enough cash'); return } state.cash -= cost; const po={id:nextPoId++, supplierId, qty, placedAt:Date.now(), requestedLead:lead, status:'pending'}; state.pos.push(po); log(`Placed PO #${po.id} qty ${qty} for ${o.part} with ${o.name} lead ${lead}s cost $${cost}`); scheduleOEMResponse(po); save(); render() }

function scheduleOEMResponse(po){ const o = (state.oems||[]).find(x=>x.id===po.supplierId); const reviewMs = 2000 + Math.floor(Math.random()*3000); setTimeout(()=>{ const acceptRoll = Math.random(); if(acceptRoll <= o.reliability){ const fillRatio = 0.6 + Math.random()*0.4; const commitQty = Math.max(1, Math.floor(po.qty * fillRatio)); const lead = Math.max(1, Math.round(po.requestedLead * o.leadModifier)); const commitEta = Date.now() + lead*1000; po.status='committed'; po.commitQty=commitQty; po.commitEta=commitEta; log(`OEM ${o.name} committed PO #${po.id} qty ${commitQty} ETA ${lead}s`) ; scheduleArrival(po) } else { po.status='rejected'; const refund = po.qty * (o.unitCost||10); state.cash += refund; log(`OEM ${o.name} rejected PO #${po.id}; refunded $${refund}`) } save(); render() }, reviewMs) }

function scheduleArrival(po){ const arrivalMs = Math.max(0, (po.commitEta || po.arrival) - Date.now()); setTimeout(()=>{ const recv = po.commitQty || po.qty; state.inventory += recv; po.status='received'; po.arrival=Date.now(); log(`PO #${po.id} received +${recv} ${((state.oems||[]).find(x=>x.id===po.supplierId)||{}).part}`); save(); render() }, arrivalMs) }

setInterval(()=>{ const sell = Math.min(state.inventory, state.demandPerSec); if(sell>0){ state.inventory -= sell; const revenue = sell * 80; state.cash += revenue; log(`Shipped ${sell} units for $${revenue}`) } render() },1000)

function restoreSchedules(){ state.pos.forEach(p=>{ if(p.status==='committed' && p.commitEta && p.commitEta>Date.now()){ scheduleArrival(p) } }) }

el.placePo.addEventListener('click', placePO); el.save.addEventListener('click', ()=>{ save(); alert('Saved') }); el.reset.addEventListener('click', ()=>{ if(confirm('Reset game?')){ localStorage.removeItem(STATE_KEY); state = JSON.parse(JSON.stringify(defaultState)); nextPoId=1; render(); } })

populateOEMs(); render(); restoreSchedules(); setInterval(()=>save(),15000)
